{"name":"lb-eval-monitor","private":true,"version":"0.2.0","type":"module","scripts":{"dev":"vite dev","build":"vite build","preview":"vite preview","prepare":"svelte-kit sync || echo ''","check":"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json","check:watch":"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch","parser:scan":"python3 parser/scan_results.py --source-root ./source/lb_eval/results --output-dir ./static/data","parser:remote":"python3 parser/scan_results.py --remote --output-dir ./static/data","parser:watch":"python3 parser/watch_remote.py --interval 300 --output-dir ./static/data","start":"concurrently \"npm run dev\" \"npm run parser:watch\""},"devDependencies":{"@sveltejs/adapter-static":"^3.0.8","@sveltejs/kit":"^2.57.0","@sveltejs/vite-plugin-svelte":"^7.0.0","@types/node":"^24.8.1","concurrently":"^9.2.1","svelte":"^5.55.2","svelte-check":"^4.4.6","typescript":"^6.0.2","vite":"^8.0.7"}}
